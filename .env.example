# 3-Way Evaluation Setup
# For a full 3-way comparison, set all three keys below.
# For 2-way: set any two. For dry-run: none required.

# OpenAI configuration (Arm A: OpenAI with elicited confidence)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Gemini configuration (Arm B: Gemini with elicited confidence)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro
# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# LLM temperature (applies to both OpenAI and Gemini)
LLM_TEMPERATURE=0.0

# Vercel AI Gateway API key (Arm C: Jev with native probabilities)
# Preferred for Jev - no TypeSafe waitlist required
# Get your key from: https://vercel.com/docs/ai-gateway/getting-started/evaluation
# Uses Jev model (typesafe-ai/jev) for calibrated probabilities
AI_GATEWAY_API_KEY=

# Legacy Jev-style API (fallback - optional)
# Only needed if you have a custom TypeSafe endpoint
# Expected interface: POST to JEV_ENDPOINT with JSON body:
#   { "question": string, "context": string[], "choices": ["answer", "refuse", "escalate"] }
# Expected response JSON:
#   { "probabilities": { "answer": number, "refuse": number, "escalate": number } }
JEV_API_KEY=
JEV_ENDPOINT=

# NOTE: LLM_PROVIDER is deprecated in favor of explicit arm selection.
# The eval harness now runs OpenAI and Gemini as separate arms when keys are present.
# LLM_PROVIDER=openai  # No longer used in main runner
