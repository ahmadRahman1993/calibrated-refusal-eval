# LLM Provider: "openai" or "gemini" (optional - dry-run works without API keys)
LLM_PROVIDER=openai

# OpenAI configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Gemini configuration
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

# LLM temperature (applies to both providers)
LLM_TEMPERATURE=0.0

# Vercel AI Gateway API key (preferred for Arm B - no TypeSafe waitlist required)
# Get your key from: https://vercel.com/docs/ai-gateway/getting-started/evaluation
# Uses Jev model (typesafe-ai/jev) for calibrated probabilities
AI_GATEWAY_API_KEY=

# Legacy Jev-style API (fallback - optional)
# Only needed if you have a custom TypeSafe endpoint
# Expected interface: POST to JEV_ENDPOINT with JSON body:
#   { "question": string, "context": string[], "choices": ["answer", "refuse", "escalate"] }
# Expected response JSON:
#   { "probabilities": { "answer": number, "refuse": number, "escalate": number } }
JEV_API_KEY=
JEV_ENDPOINT=
